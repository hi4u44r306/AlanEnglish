# 檔名帶雜湊的建置檔（程式、樣式、圖片、字型）內容永遠不會變，瀏覽器可直接沿用一整年，換頁不必再連線確認。
/static/*
  Cache-Control: public, max-age=31536000, immutable

/default-avatars/thumbs-v1/*
  Cache-Control: public, max-age=31536000, immutable

# 檔名不帶雜湊的圖片與字型：保留一天（字型一週），同一次使用期間換頁、重開 App 都不用重新確認。
/default-avatars/alan-*
  Cache-Control: public, max-age=86400

/trial/*
  Cache-Control: public, max-age=86400

/pwa/*
  Cache-Control: public, max-age=86400

/fonts/*
  Cache-Control: public, max-age=604800

# 檔名帶版本號的圖示（更新時會換檔名）。
/apple-touch-icon-v3.png
  Cache-Control: public, max-age=31536000, immutable

/android-chrome-192x192-v3.png
  Cache-Control: public, max-age=31536000, immutable

/android-chrome-512x512-v3.png
  Cache-Control: public, max-age=31536000, immutable

# Service worker 與 manifest 必須每次確認，才不會卡在舊版。
/web-push-sw.js
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache
